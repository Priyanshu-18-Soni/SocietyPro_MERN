### Register a new SocietyOwner (creates society + owner together)
POST {{baseUrl}}/api/auth/register-owner
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "password": "securepass123",
  "societyName": "Green Valley Society",
  "address": "123 Green Street",
  "city": "Springfield",
  "registrationNumber": "GV2026001"
}

### Login existing user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "securepass123"
}

### Register a new Resident (joins existing society via societyCode)
POST {{baseUrl}}/api/auth/register-resident
Content-Type: application/json

{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "password": "residentpass456",
  "societyCode": "ABC1234",
  "unitNumber": "B-205"
}

### Test protected route
GET {{baseUrl}}/api/test/protected
Authorization: Bearer {{token}}

### Create a new society (requires SuperAdmin token)
POST {{baseUrl}}/api/society
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Asmita Mogra Co-Op Housing Society",
  "address": "123 Test Street",
  "city": "Mumbai",
  "registrationNumber": "REG12345"
}

### Get all societies (requires SuperAdmin token)
GET {{baseUrl}}/api/society
Authorization: Bearer {{token}}

### Get a single society by ID (requires token)
GET {{baseUrl}}/api/society/{{societyId}}
Authorization: Bearer {{token}}

### Register a SocietyAdmin (for testing user routes) — use a real societyId from a society you already created
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Society Admin Test",
  "email": "societyadmin@societypro.com",
  "password": "test1234",
  "role": "SocietyAdmin",
  "societyId": "{{societyId}}",
  "unitNumber": "A-101"
}

### Get all users in my society (requires SocietyAdmin token)
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}

### Get a single user by ID (requires SocietyAdmin token)
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{token}}

### Update a user (requires SocietyAdmin token)
PATCH {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "unitNumber": "B-202"
}

### Update a society (SuperAdmin only)
PATCH {{baseUrl}}/api/society/{{societyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "city": "Navi Mumbai"
}

### Delete a society (SuperAdmin only)
DELETE {{baseUrl}}/api/society/{{societyId}}
Authorization: Bearer {{token}}

### Create a Razorpay order (Resident/SocietyAdmin token required)
POST {{baseUrl}}/api/payments/create-order
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 1500
}

### Verify a Razorpay payment (after frontend checkout completes)
POST {{baseUrl}}/api/payments/verify
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "razorpay_order_id": "order_XXXXXXXXXXXX",
  "razorpay_payment_id": "pay_XXXXXXXXXXXX",
  "razorpay_signature": "your_generated_signature_here"
}

### Generate a new bill (SocietyAdmin only)
POST {{baseUrl}}/api/payments/generate-bill
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "residentId": "{{userId}}",
  "amount": 1500,
  "unitNumber": "A-101",
  "month": "August 2026",
  "dueDate": "2026-08-15"
}

### Get bills/payment history (Resident/SocietyAdmin)
GET {{baseUrl}}/api/payments
Authorization: Bearer {{token}}

### Get bills with status filter
GET {{baseUrl}}/api/payments?status=created
Authorization: Bearer {{token}}

### Committee Management Endpoints

# Create a committee member
POST {{baseUrl}}/api/committee
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Treasurer Test",
  "email": "treasurer@example.com",
  "password": "treasurerpass1",
  "customLabel": "Treasurer",
  "permissions": ["manageBills"]
}

### Get all committee members
GET {{baseUrl}}/api/committee
Authorization: Bearer {{token}}

# Update committee member permissions
PATCH {{baseUrl}}/api/committee/{{committeeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "permissions": ["manageBills", "manageResidents"]
}

# Delete a committee member
DELETE {{baseUrl}}/api/committee/{{committeeId}}
Authorization: Bearer {{token}}

### =======================================================
### Gatekeeper Lifecycle & Resident Moderation
### =======================================================

### Get pending residents awaiting approval (SocietyOwner or Committee with manageResidents)
GET {{baseUrl}}/api/users/residents/pending
Authorization: Bearer {{token}}

### Approve a pending resident
PATCH {{baseUrl}}/api/users/residents/{{userId}}/approve
Authorization: Bearer {{token}}

### Reject a pending resident
PATCH {{baseUrl}}/api/users/residents/{{userId}}/reject
Authorization: Bearer {{token}}

### =======================================================
### Grievance Redressal Engine (Complaints)
### =======================================================

### Create a new complaint ticket (Active Resident / Committee / Owner)
POST {{baseUrl}}/api/complaints
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Water leakage in lobby pipe",
  "description": "Pipe leaking on ground floor lobby near elevator B",
  "imageUrl": "https://example.com/leakage.jpg"
}

### List all complaints in society (optional filter: ?status=open)
GET {{baseUrl}}/api/complaints?status=open
Authorization: Bearer {{token}}

### Upvote a complaint (adds current resident flat to affectedFlats)
PATCH {{baseUrl}}/api/complaints/{{complaintId}}/upvote
Authorization: Bearer {{token}}

### Update complaint status (Owner or Committee with resolveComplaints)
PATCH {{baseUrl}}/api/complaints/{{complaintId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "in_progress"
}

### Submit verdict for complaint (Ticket creator only)
PATCH {{baseUrl}}/api/complaints/{{complaintId}}/verdict
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "verdict": "confirmed"
}

### =======================================================
### Notice Board Engine
### =======================================================

### Get all notices for society (sorted by priority & date)
GET {{baseUrl}}/api/notices
Authorization: Bearer {{token}}

### Create a notice (Owner or Committee with manageNotices)
POST {{baseUrl}}/api/notices
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Annual General Meeting 2026",
  "body": "The AGM will be held this Sunday at 10:00 AM in the clubhouse.",
  "isPriority": true
}

### Toggle pin/unpin for a notice
PATCH {{baseUrl}}/api/notices/{{noticeId}}/pin
Authorization: Bearer {{token}}

### Delete a notice (Owner or Committee with manageNotices)
DELETE {{baseUrl}}/api/notices/{{noticeId}}
Authorization: Bearer {{token}}

### =======================================================
### Treasury Ledger & Finances
### =======================================================

### Record a manual expense (Owner or Committee with manageBills)
POST {{baseUrl}}/api/finances/expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "category": "Gardening & Landscaping",
  "amount": 2500,
  "paymentMethod": "bank_transfer",
  "description": "Monthly gardener contractor payment"
}

### Get financial metrics & ledger transaction history
GET {{baseUrl}}/api/finances/metrics
Authorization: Bearer {{token}}

### =======================================================
### Razorpay Webhook Simulation
### =======================================================

### Razorpay Webhook listener (Requires x-razorpay-signature header with HMAC-SHA256)
POST {{baseUrl}}/api/payments/webhook
Content-Type: application/json
x-razorpay-signature: hex_digest_signature_here

{
  "event": "payment.captured",
  "payload": {
    "payment": {
      "entity": {
        "id": "pay_test123456",
        "order_id": "order_test123456",
        "amount": 150000,
        "status": "captured"
      }
    }
  }
}