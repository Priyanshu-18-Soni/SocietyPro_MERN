### Register a new SocietyOwner (creates society + owner together)
POST {{baseUrl}}/api/auth/register-owner
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "password": "securepass123",
  "societyName": "Green Valley Society",
  "address": "123 Green Street",
  "city": "Springfield",
  "registrationNumber": "GV2026001"
}

### Login existing user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "securepass123"
}

### Register a new Resident (joins existing society via societyCode)
POST {{baseUrl}}/api/auth/register-resident
Content-Type: application/json

{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "password": "residentpass456",
  "societyCode": "ABC1234",
  "unitNumber": "B-205"
}

### Test protected route
GET {{baseUrl}}/api/test/protected
Authorization: Bearer {{token}}

### Create a new society (requires SuperAdmin token)
POST {{baseUrl}}/api/society
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Asmita Mogra Co-Op Housing Society",
  "address": "123 Test Street",
  "city": "Mumbai",
  "registrationNumber": "REG12345"
}

### Get all societies (requires SuperAdmin token)
GET {{baseUrl}}/api/society
Authorization: Bearer {{token}}

### Get a single society by ID (requires token)
GET {{baseUrl}}/api/society/{{societyId}}
Authorization: Bearer {{token}}

### Register a SocietyAdmin (for testing user routes) — use a real societyId from a society you already created
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Society Admin Test",
  "email": "societyadmin@societypro.com",
  "password": "test1234",
  "role": "SocietyAdmin",
  "societyId": "{{societyId}}",
  "unitNumber": "A-101"
}

### Get all users in my society (requires SocietyAdmin token)
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}

### Get a single user by ID (requires SocietyAdmin token)
GET {{baseUrl}}/api/users/{{userId}}
Authorization: Bearer {{token}}

### Update a user (requires SocietyAdmin token)
PATCH {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "unitNumber": "B-202"
}

### Update a society (SuperAdmin only)
PATCH {{baseUrl}}/api/society/{{societyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "city": "Navi Mumbai"
}

### Delete a society (SuperAdmin only)
DELETE {{baseUrl}}/api/society/{{societyId}}
Authorization: Bearer {{token}}

### Create a Razorpay order (Resident/SocietyAdmin token required)
POST {{baseUrl}}/api/payments/create-order
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 1500
}

### Verify a Razorpay payment (after frontend checkout completes)
POST {{baseUrl}}/api/payments/verify
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "razorpay_order_id": "order_XXXXXXXXXXXX",
  "razorpay_payment_id": "pay_XXXXXXXXXXXX",
  "razorpay_signature": "your_generated_signature_here"
}

### Generate a new bill (SocietyAdmin only)
POST {{baseUrl}}/api/payments/generate-bill
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "residentId": "{{userId}}",
  "amount": 1500,
  "unitNumber": "A-101",
  "month": "August 2026",
  "dueDate": "2026-08-15"
}

### Get bills/payment history (Resident/SocietyAdmin)
GET {{baseUrl}}/api/payments
Authorization: Bearer {{token}}

### Get bills with status filter
GET {{baseUrl}}/api/payments?status=created
Authorization: Bearer {{token}}

### Committee Management Endpoints

# Create a committee member
POST {{baseUrl}}/api/committee
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Treasurer Test",
  "email": "treasurer@example.com",
  "password": "treasurerpass1",
  "customLabel": "Treasurer",
  "permissions": ["manageBills"]
}

### Get all committee members
GET {{baseUrl}}/api/committee
Authorization: Bearer {{token}}

# Update committee member permissions
PATCH {{baseUrl}}/api/committee/{{committeeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "permissions": ["manageBills", "manageResidents"]
}

# Delete a committee member
DELETE {{baseUrl}}/api/committee/{{committeeId}}
Authorization: Bearer {{token}}